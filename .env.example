# Environment variables
NODE_ENV=development
PORT=3000

# SQLite database (zero configuration; change to postgresql://... for production PostgreSQL)
DATABASE_URL="file:./dev.db"

# 32-character AES-256-GCM secret for encrypting Evolution API keys and secrets at rest
APP_SECRET="super-secret-key-32-chars-bulk123"

# JWT secret for auth sessions
JWT_SECRET="jwt-session-secret-change-in-prod-xyz789"

# Redis URL for BullMQ queue worker
REDIS_URL="redis://127.0.0.1:6379"

# Evolution API (can also be configured via Settings UI in the database)
EVOLUTION_API_URL="http://evolution:8080"
GLOBAL_API_KEY=""

# PostgreSQL configuration for Evolution API v2
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI="postgresql://evolution:evolution_pass@postgres:5432/evolution?schema=public"

# Webhook shared secret
WEBHOOK_SECRET="whsec-shared-evolution-bulk-2026"
