// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         String     @default("OPERATOR") // "ADMIN" or "OPERATOR"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Setting {
  key         String   @id
  value       String
  isEncrypted Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Instance {
  id            String             @id @default(cuid())
  name          String             @unique
  status        String             @default("CLOSE") // "OPEN", "CONNECTING", "CLOSE"
  profileName   String?
  profileNumber String?
  profilePicUrl String?
  dailyCap      Int                @default(200)
  sentToday     Int                @default(0)
  lastResetDate String?
  warmUpDay     Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  campaigns     CampaignInstance[]
}

model Contact {
  id              String        @id @default(cuid())
  phone           String        @unique
  name            String?
  customFields    String? // JSON string: { "company": "Acme", "city": "Delhi" }
  tags            String? // JSON array: ["vip", "leads"]
  optInStatus     Boolean       @default(true)
  isBlacklisted   Boolean       @default(false)
  blacklistReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lists           ListContact[]
}

model ContactList {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contacts    ListContact[]
}

model ListContact {
  listId    String
  contactId String
  createdAt DateTime    @default(now())
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
}

model Blacklist {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  source    String   @default("MANUAL") // "MANUAL", "BULK_IMPORT", "OPT_OUT"
  createdAt DateTime @default(now())
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String
  mediaType String?  @default("text") // "text", "image", "video", "document", "audio"
  mediaUrl  String?
  fileName  String?
  caption   String?
  tags      String? // JSON array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id                 String              @id @default(cuid())
  name               String
  status             String              @default("DRAFT") // "DRAFT", "SCHEDULED", "RUNNING", "PAUSED", "COMPLETED", "ABORTED", "FAILED"
  minDelay           Int                 @default(12)
  maxDelay           Int                 @default(25)
  simulateTyping     Boolean             @default(true)
  batchBreakSize     Int                 @default(30)
  batchBreakDuration Int                 @default(5) // in minutes
  sendWindowStart    String              @default("09:00")
  sendWindowEnd      String              @default("20:00")
  timezone           String              @default("Asia/Kolkata")
  warmUpMode         Boolean             @default(false)
  rotationMode       String              @default("ROUND_ROBIN") // "ROUND_ROBIN" or "LEAST_USED"
  consentConfirmedAt DateTime?
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  haltReason         String?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  instances          CampaignInstance[]
  variants           CampaignVariant[]
  recipients         CampaignRecipient[]
}

model CampaignInstance {
  campaignId String
  instanceId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@id([campaignId, instanceId])
}

model CampaignVariant {
  id            String   @id @default(cuid())
  campaignId    String
  index         Int      @default(0)
  content       String
  mediaType     String?  @default("text")
  mediaUrl      String?
  fileName      String?
  caption       String?
  weightPercent Int      @default(100)
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignRecipient {
  id                 String    @id @default(cuid())
  campaignId         String
  contactId          String?
  phone              String
  name               String?
  customVariables    String? // JSON
  variantIndex       Int       @default(0)
  status             String    @default("PENDING") // "PENDING", "SENDING", "SENT", "DELIVERED", "READ", "FAILED", "SKIPPED", "REPLIED"
  attempts           Int       @default(0)
  lastError          String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  messageId          String?
  renderedMessage    String?
  instanceUsed       String?
  evaluationStatus   String?   @default("UNVERIFIED") // "VERIFIED_WA", "NOT_WA", "QUALITY_PASSED", "SPAM_FLAGGED"
  qualityScore       Int?      @default(100)
  campaign           Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([phone])
}

model IncomingMessage {
  id           String   @id @default(cuid())
  messageId    String   @unique
  instanceName String
  phone        String
  pushName     String?
  body         String
  status       String   @default("UNREAD") // "UNREAD", "READ", "HANDLED"
  isOptOut     Boolean  @default(false)
  receivedAt   DateTime @default(now())

  @@index([phone])
  @@index([instanceName])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String // e.g. "CAMPAIGN_START", "INSTANCE_CREATE", "SETTINGS_UPDATE"
  entity    String // "CAMPAIGN", "INSTANCE", "SETTINGS", "CONTACT"
  details   String? // JSON details
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

