// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         String     @default("OPERATOR") // "ADMIN" or "OPERATOR"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Setting {
  key         String   @id
  value       String
  isEncrypted Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Instance {
  id                String             @id @default(cuid())
  name              String             @unique
  evolutionName     String?
  status            String             @default("CLOSE") // "OPEN", "CONNECTING", "CLOSE"
  profileName       String?
  profileNumber     String?
  profilePicUrl     String?
  dailyCap          Int                @default(200)
  sentToday         Int                @default(0)
  lastResetDate     String?
  warmUpDay         Int                @default(1)
  warmupSchedule    String?            // JSON array e.g. [20, 40, 60, 100, 150, 200, 250]
  health            String?            // JSON health info
  connectedAt       DateTime?
  warmupStartedAt   DateTime?
  circuitState      String             @default("closed") // "closed", "open", "half-open"
  consecutiveErrors Int                @default(0)
  lastErrorAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  campaigns         CampaignInstance[]
}

model Contact {
  id              String        @id @default(cuid())
  phone           String        @unique
  name            String?
  customFields    String?       // JSON string: { "company": "Acme", "city": "Delhi" }
  tags            String?       // JSON array: ["vip", "leads"]
  optInStatus     Boolean       @default(true)
  isBlacklisted   Boolean       @default(false)
  blacklistReason String?
  source          String?       @default("MANUAL")
  waExists        Boolean?
  waCheckedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lists           ListContact[]
}

model ContactList {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contacts    ListContact[]
}

model LeadDeal {
  id              String    @id @default(cuid())
  title           String
  value           Float     @default(0)
  currency        String    @default("INR")
  stage           String    @default("NEW_LEAD") // "NEW_LEAD" | "CONTACTED" | "QUALIFIED" | "PROPOSAL" | "WON" | "LOST"
  contactName     String?
  contactPhone    String
  tags            String?   // JSON array string
  notes           String?
  assignedTo      String?   @default("Unassigned")
  priority        String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  expectedCloseAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([stage])
  @@index([contactPhone])
}

model CrmTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#0c57e4")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmCustomField {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  type        String   @default("TEXT") // "TEXT" | "NUMBER" | "DATE" | "DROPDOWN"
  options     String?  // JSON array string for DROPDOWN
  description String?
  isVisible   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PipelineStageConfig {
  id           String   @id @default(cuid())
  pipelineName String   @default("Falcon")
  description  String?
  stages       String   // JSON string of workflow stages
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ListContact {
  listId    String
  contactId String
  createdAt DateTime    @default(now())
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
}

model Blacklist {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  source    String   @default("MANUAL") // "MANUAL", "BULK_IMPORT", "OPT_OUT", "COMPLAINT"
  createdAt DateTime @default(now())
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String
  mediaType String?  @default("text") // "text", "image", "video", "document", "audio"
  mediaUrl  String?
  fileName  String?
  caption   String?
  tags      String?  // JSON array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  sha256    String   @unique
  mime      String
  size      Int
  path      String
  url       String?
  data      String?
  title     String?
  fileName  String?
  category  String?  @default("image") // "image", "video", "document", "audio"
  tags      String?  @default("[]")    // JSON array string
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CrmTask {
  id           String    @id @default(cuid())
  title        String
  description  String?
  dueDate      DateTime?
  priority     String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  status       String    @default("PENDING") // "PENDING", "COMPLETED", "CANCELLED"
  assignedTo   String?   @default("Unassigned")
  contactPhone String?
  dealId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([contactPhone])
}

model QuickReply {
  id        String   @id @default(cuid())
  shortcut  String   @unique // e.g. "/pricing", "/help", "/demo"
  title     String
  content   String
  category  String   @default("General")
  mediaUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model Campaign {
  id                 String              @id @default(cuid())
  name               String
  status             String              @default("DRAFT") // "DRAFT", "SCHEDULED", "RUNNING", "PAUSED", "COMPLETED", "ABORTED", "FAILED"
  minDelay           Int                 @default(12)
  maxDelay           Int                 @default(25)
  simulateTyping     Boolean             @default(true)
  batchBreakSize     Int                 @default(30)
  batchBreakDuration Int                 @default(5) // in minutes
  sendWindowStart    String              @default("09:00")
  sendWindowEnd      String              @default("20:00")
  timezone           String              @default("Asia/Kolkata")
  warmUpMode         Boolean             @default(false)
  rotationMode       String              @default("ROUND_ROBIN") // "ROUND_ROBIN" or "LEAST_USED"
  distributionMode   String              @default("SINGLE")      // "SINGLE", "ROTATE", "RANDOM", "WEIGHTED"
  rotationScope      String              @default("CAMPAIGN")    // "CAMPAIGN", "INSTANCE", "LIST"
  shuffleAudience    Boolean             @default(false)
  shuffleSeed        Int?
  avoidRepeatContent Boolean             @default(true)
  riskScore          Int?                @default(0)
  riskFactors        String?             // JSON
  riskOverride       Boolean             @default(false)
  riskOverrideBy     String?
  consentConfirmedAt DateTime?
  consentConfirmedBy String?
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  haltReason         String?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  instances          CampaignInstance[]
  variants           CampaignVariant[]
  recipients         CampaignRecipient[]
}

model CampaignInstance {
  campaignId String
  instanceId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@id([campaignId, instanceId])
}

model CampaignVariant {
  id                 String              @id @default(cuid())
  campaignId         String
  index              Int                 @default(0)
  position           Int                 @default(1)
  label              String?             @default("Message 1")
  content            String
  mediaType          String?             @default("text")
  mediaUrl           String?
  fileName           String?
  caption            String?
  weightPercent      Int                 @default(100)
  weight             Int?
  contentHash        String?
  similarityWarnings String?
  isPaused           Boolean             @default(false)
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipients         CampaignRecipient[]
}

model CampaignRecipient {
  id                 String           @id @default(cuid())
  campaignId         String
  contactId          String?
  phone              String
  name               String?
  customVariables    String?          // JSON
  variantIndex       Int              @default(0)
  variantId          String?
  rotationIndex      Int?
  status             String           @default("PENDING") // "PENDING", "QUEUED", "SENDING", "SENT", "DELIVERED", "READ", "FAILED", "RETRY_WAIT", "UNCERTAIN", "CANCELLED", "SKIPPED"
  attempts           Int              @default(0)
  maxAttempts        Int              @default(3)
  lastError          String?
  errorCode          String?
  queuedAt           DateTime?
  sendingAt          DateTime?
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  repliedAt          DateTime?
  messageId          String?
  evolutionMessageId String?
  remoteJid          String?
  renderedMessage    String?
  instanceUsed       String?
  evaluationStatus   String?          @default("UNVERIFIED") // "VERIFIED_WA", "NOT_WA", "QUALITY_PASSED", "SPAM_FLAGGED"
  qualityScore       Int?             @default(100)
  campaign           Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variant            CampaignVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@index([campaignId, variantId])
  @@index([phone])
  @@index([evolutionMessageId])
}

model DailyInstanceCounter {
  id         String   @id @default(cuid())
  instanceId String
  localDate  String   // "YYYY-MM-DD"
  sent       Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([instanceId, localDate])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  instanceId  String?
  dedupeKey   String    @unique
  type        String
  payload     String    // JSON
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([instanceId, type])
}

model IncomingMessage {
  id           String    @id @default(cuid())
  messageId    String    @unique
  instanceName String
  phone        String
  pushName     String?
  body         String
  status       String    @default("UNREAD") // "UNREAD", "READ", "HANDLED"
  isOptOut     Boolean   @default(false)
  remoteJid    String?
  campaignId   String?
  botSessionId String?
  botNodeId    String?
  source       String?   @default("manual") // "campaign", "bot", "manual", "api"
  receivedAt   DateTime  @default(now())

  @@index([phone])
  @@index([instanceName])
}

model OutboundWebhook {
  id        String   @id @default(cuid())
  url       String
  secret    String
  events    String   // JSON array
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  keyHash   String   @unique
  role      String   @default("OPERATOR")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String   // e.g. "CAMPAIGN_START", "INSTANCE_CREATE", "SETTINGS_UPDATE"
  entity    String   // "CAMPAIGN", "INSTANCE", "SETTINGS", "CONTACT"
  entityId  String?
  details   String?  // JSON details
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model GuardrailProfile {
  id         String   @id @default(cuid())
  scope      String   // "global", "instance", "campaign"
  scopeId    String   @default("") // "" for global, instanceName or campaignId
  presetKey  String?  // "ultra-safe", "safe", "balanced", "aggressive", "custom"
  config     String   // JSON of GuardrailConfig
  strictMode Boolean  @default(false)
  version    Int      @default(1)
  updatedBy  String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([scope, scopeId])
  @@index([scope, scopeId])
}

model GuardrailPreset {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  config      String   // JSON
  isBuiltin   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuardrailVersion {
  id             String   @id @default(cuid())
  profileId      String
  version        Int
  config         String   // JSON
  diffSummary    String?
  source         String   @default("manual") // "manual", "preset", "advisor", "import", "restore"
  advisorRunId   String?
  savedBy        String?
  savedAt        DateTime @default(now())

  @@index([profileId, version])
}

model GuardrailEvent {
  id          String   @id @default(cuid())
  instanceId  String?
  campaignId  String?
  type        String   // "BREAKER_OPEN", "CAP_REACHED", "HEALTH_TRIGGER", "OVERRIDE_USED", "BLOCKED_LAUNCH", "PACING_DELAY"
  severity    String   // "info", "warning", "critical"
  detail      String   // JSON
  createdAt   DateTime @default(now())

  @@index([type, severity])
  @@index([instanceId])
  @@index([campaignId])
}

model AiSettings {
  id                     String   @id @default("default")
  provider               String   @default("openrouter")
  apiKeyEncrypted        String?
  model                  String   @default("anthropic/claude-3.5-haiku")
  fallbackModel          String?  @default("openai/gpt-4o-mini")
  monthlyCapUsd          Float    @default(10.0)
  maxTokens              Int      @default(2048)
  temperature            Float    @default(0.2)
  timeoutMs              Int      @default(30000)
  includeContentAnalysis Boolean  @default(false)
  enabled                Boolean  @default(true)
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())
}

model AiUsage {
  id               String   @id @default(cuid())
  runId            String?
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0.0)
  createdAt        DateTime @default(now())
}

model AdvisorRun {
  id              String                  @id @default(cuid())
  scope           String                  @default("global") // "global" | "instance"
  scopeId         String?                 @default("")
  windowDays      Int                     @default(14)
  goal            String                  @default("Balanced") // "Maximize safety" | "Balanced" | "Maximize throughput within safe limits"
  notes           String?
  model           String                  @default("rule_based")
  mode            String                  @default("rule_based") // "ai" | "rule_based"
  inputSummary    String                  // JSON
  output          String                  // JSON
  validatedOutput String                  // JSON
  discardedCount  Int                     @default(0)
  status          String                  @default("completed") // "running" | "completed" | "failed"
  costUsd         Float                   @default(0.0)
  createdBy       String?
  createdAt       DateTime                @default(now())
  recommendations AdvisorRecommendation[]
  experiments     AdvisorExperiment[]
}

model AdvisorRecommendation {
  id               String     @id @default(cuid())
  runId            String
  fieldPath        String
  currentValue     String     // JSON
  suggestedValue   String     // JSON
  rationale        String
  expectedEffect   String?
  riskChange       String     @default("neutral") // "lower" | "neutral" | "higher"
  confidence       String     @default("medium") // "low" | "medium" | "high"
  priority         Int        @default(1)
  status           String     @default("pending") // "pending" | "applied" | "dismissed"
  appliedVersionId String?
  createdAt        DateTime   @default(now())
  run              AdvisorRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
}

model AdvisorExperiment {
  id              String      @id @default(cuid())
  runId           String
  baselineMetrics String      // JSON
  appliedChanges  String      // JSON
  status          String      @default("evaluating") // "evaluating" | "completed" | "reverted"
  verdict         String?     // "improved" | "no_change" | "worse"
  result          String?     // JSON
  startedAt       DateTime    @default(now())
  evaluatedAt     DateTime?
  run             AdvisorRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   @default("info") // "info", "warn", "error"
  source    String   @default("worker") // "worker", "app", "evolution"
  message   String
  details   String?  // JSON string or stack trace
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([source, createdAt])
}

model WorkerHeartbeat {
  id        String   @id @default("default")
  status    String   @default("ACTIVE")
  lastSeen  DateTime @default(now())
  metadata  String?  // JSON
}

// =========================================================
// CHATBOT STUDIO (Visual Flow Builder & Runtime Models)
// =========================================================

model Flow {
  id            String           @id @default(cuid())
  name          String
  description   String?
  status        String           @default("draft") // "draft" | "live" | "paused" | "archived"
  currentDraft  String           // JSON string of nodes, edges, viewport
  liveVersionId String?
  draftRevision Int              @default(1)
  createdBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  versions      FlowVersion[]
  assignments   FlowAssignment[]
  triggers      FlowTrigger[]
  sessions      BotSession[]

  @@index([status])
}

model FlowVersion {
  id          String       @id @default(cuid())
  flowId      String
  version     Int
  compiled    String       // JSON string of compiled executable flow
  note        String?
  publishedBy String?
  publishedAt DateTime     @default(now())
  flow        Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  sessions    BotSession[]

  @@unique([flowId, version])
  @@index([flowId])
}

model FlowAssignment {
  id          String   @id @default(cuid())
  flowId      String
  instanceId  String
  enabled     Boolean  @default(true)
  priority    Int      @default(1)
  activeHours String?  // JSON string
  settings    String?  // JSON string
  flow        Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, instanceId])
  @@index([instanceId, enabled])
}

model FlowTrigger {
  id        String @id @default(cuid())
  flowId    String
  type      String // "keyword" | "first_message" | "fallback" | "campaign_reply" | "webhook"
  config    String // JSON string (keywords, matchMode, etc.)
  priority  Int    @default(1)
  flow      Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, type])
}

model BotSession {
  id             String       @id @default(cuid())
  flowId         String
  versionId      String?
  instanceId     String
  contactId      String?
  phone          String
  status         String       @default("active") // "active" | "waiting" | "handoff" | "completed" | "expired" | "error"
  currentNodeId  String?
  vars           String       @default("{}") // JSON string of variables
  stepSeq        Int          @default(0)
  startedAt      DateTime     @default(now())
  lastInboundAt  DateTime     @default(now())
  lastOutboundAt DateTime?
  expiresAt      DateTime?
  endReason      String?      // "completed" | "handoff" | "opt_out" | "error" | "timeout" | "cancelled"
  flow           Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  version        FlowVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  events         BotEvent[]

  @@index([instanceId, phone, status])
  @@index([status, expiresAt])
}

model BotEvent {
  id         String     @id @default(cuid())
  sessionId  String
  stepSeq    Int
  nodeId     String
  type       String     // "node_entered" | "action_executed" | "user_input" | "error"
  input      String?    // JSON string
  output     String?    // JSON string
  durationMs Int        @default(0)
  error      String?
  createdAt  DateTime   @default(now())
  session    BotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, stepSeq])
  @@index([createdAt])
}

model KnowledgeSource {
  id        String   @id @default(cuid())
  flowId    String?
  type      String   @default("faq") // "faq" | "text" | "doc"
  title     String
  content   String
  chunks    String?  // JSON string array of chunks
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FlowTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  category    String   @default("general") // "lead_gen" | "support" | "sales" | "utility"
  flow        String   // JSON string of nodes, edges
  isBuiltin   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Multi-Tenant Reseller & SaaS Client Management Model
model ResellerClient {
  id              String    @id @default(cuid())
  companyName     String
  slug            String    @unique
  ownerName       String
  ownerEmail      String    @unique
  ownerPhone      String?
  passwordHash    String

  // Subscription & Tier
  planName        String    @default("Starter") // "Starter", "Growth", "Enterprise", "Custom"
  status          String    @default("ACTIVE")  // "ACTIVE", "SUSPENDED", "TRIAL", "EXPIRED"
  billingCycle    String    @default("MONTHLY") // "MONTHLY", "ANNUAL", "LIFETIME"
  price           Float     @default(0)
  currency        String    @default("INR")
  renewalDate     DateTime?

  // Resource Quotas
  maxInstances    Int       @default(1)
  maxContacts     Int       @default(5000)
  monthlyMsgCap   Int       @default(10000)
  walletBalance   Float     @default(0)

  // Feature Access Flags
  hasCrmPipeline  Boolean   @default(true)
  hasChatbot      Boolean   @default(true)
  hasMultiWarmup  Boolean   @default(true)
  hasDamMedia     Boolean   @default(true)
  hasAiResponder  Boolean   @default(false)

  // White-Label Customization
  customDomain    String?
  brandColor      String    @default("#0c57e4")
  logoUrl         String?

  // Isolated Tenant Settings & Integrations
  aiApiKey        String?
  aiModel         String?   @default("anthropic/claude-3.5-haiku")
  webhookUrl      String?
  webhookSecret   String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([ownerEmail])
}

// Peer-to-Peer WhatsApp Number Warmer Session Model
model NumberWarmerSession {
  id               String    @id @default(cuid())
  instanceA        String
  instanceB        String
  phoneA           String?
  phoneB           String?
  status           String    @default("IDLE") // "IDLE", "RUNNING", "PAUSED", "COMPLETED"
  dailyCap         Int       @default(25)
  todayExchanges   Int       @default(0)
  topic            String    @default("casual") // "casual", "business", "tech", "travel", "lifestyle"
  minDelaySeconds  Int       @default(45)
  maxDelaySeconds  Int       @default(90)
  useAi            Boolean   @default(false)
  aiPrompt         String?
  lastExchangedAt  DateTime?
  nextScheduledAt  DateTime?
  logs             String    @default("[]") // JSON string of dialogue exchange history
  clientId         String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([clientId])
}




